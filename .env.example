# ============================================
# Task Management App — Environment Variables
# Spring Boot Backend + Next.js Frontend
# ============================================

# --- Backend (Spring Boot) ---

# PostgreSQL — JDBC format (for Spring Boot)
DB_URL=jdbc:postgresql://host:port/database
DB_USERNAME=postgres
DB_PASSWORD=yourpassword

# PostgreSQL — URL format (alternate)
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Secrets (must be at least 32 characters / 256 bits)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars

# JWT Expiry (in milliseconds)
JWT_ACCESS_EXP_MS=900000       # 15 minutes
JWT_REFRESH_EXP_MS=604800000   # 7 days

# Server port
PORT=5000

# CORS — must match your frontend URL exactly
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) ---

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api
